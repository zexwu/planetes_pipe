include README.md pyproject.toml uv.lock
recursive-include planetes *.py *.ecsv *.fits
recursive-include tests *.py
recursive-include docs *.md *.dot *.svg *.png
recursive-include examples *.in *.py
recursive-include integration *.patch *.json
prune build
prune reduced
prune output
global-exclude __pycache__ *.py[cod] *.nbc *.nbi *.pdf .DS_Store
