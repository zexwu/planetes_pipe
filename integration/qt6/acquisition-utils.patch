+def camera_metadata(
+    cam, category, active, camera_config, *, source="command", exposure_us=None
+):
+    """Snapshot supported readbacks and explicitly sourced physical camera settings."""
+    from planetes.instrument import DetectorSetup
+    from planetes.io.acquisition import CaptureMetadata, build_raw_header
+
+    required = ("detector", "orientation", "binning_x", "binning_y")
+    if any(camera_config.get(key) in (None, "", 0) for key in required):
+        raise ValueError(
+            "Confirm camera detector, orientation and physical binning_x/binning_y"
+        )
+    values = {
+        name: int(cam.get_property(prop))
+        for name, prop in [
+            ("origin_x", "offset_x"),
+            ("origin_y", "offset_y"),
+            ("width", "width"),
+            ("height", "height"),
+        ]
+    }
+    try:
+        exposure = float(cam.get_property("exposure_time"))
+        if not np.isfinite(exposure) or exposure <= 0:
+            raise ValueError("Unavailable exposure readback")
+        exposure_source = "readback"
+    except Exception:
+        if exposure_us is None:
+            raise ValueError(
+                "Camera exposure readback unavailable; explicit command setting required"
+            ) from None
+        exposure, exposure_source = exposure_us, "command"
+    setup = DetectorSetup(
+        **values,
+        exposure_s=exposure / 1e6,
+        exposure_source=exposure_source,
+        **{key: camera_config[key] for key in required},
+    )
+    metadata = CaptureMetadata(
+        category,
+        tuple(str(n) in str(active) for n in range(1, 5)),
+        setup,
+        source,
+        host_start_utc=utc_now(),
+        original={
+            "setup_sources": {
+                **{key: "readback" for key in values},
+                **{key: "operator" for key in required},
+                "exposure_s": exposure_source,
+            }
+        },
+    )
+    build_raw_header(metadata, (1, setup.height, setup.width))
+    return metadata
+
+
+def check_camera(cam, metadata):
+    """Refuse a cube if supported fixed camera settings changed during capture."""
+    for name, prop in [
+        ("origin_x", "offset_x"),
+        ("origin_y", "offset_y"),
+        ("width", "width"),
+        ("height", "height"),
+    ]:
+        if int(cam.get_property(prop)) != getattr(metadata.setup, name):
+            raise ValueError(f"Camera {prop} changed during capture; cube not saved")
+    if metadata.setup.exposure_source == "readback":
+        exposure = float(cam.get_property("exposure_time")) / 1e6
+        if exposure != metadata.setup.exposure_s:
+            raise ValueError("Camera exposure changed during capture; cube not saved")
+
