+def utc_now():
+    """Host event time, never substituted for a camera exposure timestamp."""
+    from datetime import datetime, timezone
+
+    return (
+        datetime.now(timezone.utc)
+        .isoformat(timespec="milliseconds")
+        .replace("+00:00", "")
+    )
+
