+    def _confirm_capture_configuration(self):
+        dialog=QtWidgets.QDialog(self)
+        dialog.setWindowTitle("Confirm fixed capture settings")
+        form=QtWidgets.QFormLayout(dialog)
+        shutters=[]
+        previous=self.capture_configuration or {}
+        for i in range(1,5):
+            check=QtWidgets.QCheckBox(f"Physical shutter {i} open")
+            check.setChecked(str(i) in previous.get("active",""))
+            form.addRow(check); shutters.append(check)
+        detector=QtWidgets.QLineEdit(previous.get("detector",""))
+        orientation=QtWidgets.QLineEdit(previous.get("orientation",""))
+        bx=QtWidgets.QSpinBox();bx.setRange(0,64);bx.setValue(previous.get("binning_x",0))
+        by=QtWidgets.QSpinBox();by.setRange(0,64);by.setValue(previous.get("binning_y",0))
+        for label,widget in [("Detector identifier",detector),("Sensor orientation",orientation),
+                             ("Physical camera binning X",bx),("Physical camera binning Y",by)]:
+            form.addRow(label,widget)
+        confirmation=QtWidgets.QCheckBox("I confirm these settings remain fixed for this cube")
+        form.addRow(confirmation)
+        buttons=QtWidgets.QDialogButtonBox(QtWidgets.QDialogButtonBox.StandardButton.Ok | QtWidgets.QDialogButtonBox.StandardButton.Cancel)
+        buttons.accepted.connect(dialog.accept);buttons.rejected.connect(dialog.reject);form.addRow(buttons)
+        if not dialog.exec():
+            return None
+        if not confirmation.isChecked():
+            raise ValueError("Confirm the physical configuration before capture")
+        return {"active":"".join(str(i+1) for i,c in enumerate(shutters) if c.isChecked()),
+                "detector":detector.text().strip(),"orientation":orientation.text().strip(),
+                "binning_x":bx.value(),"binning_y":by.value()}
+
+    def _start_capture(self):
