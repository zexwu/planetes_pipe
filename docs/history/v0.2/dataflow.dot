digraph Dataflow {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=0.6, splines=polyline, fontname="PingFang SC", fontsize=18, label="PLANETES 0.2 数据处理流程", labelloc=t];
  node [shape=box, style="rounded", fontname="PingFang SC", fontsize=14, color="#64748b", margin="0.12,0.1"];
  edge [fontname="PingFang SC", fontsize=11, color="#64748b", arrowsize=0.7];
  rawflat [label="探测器 dark\n四个望远镜 flat", group=raw];
  flat [label="planetes_flat\n暗场、坏像素、光谱轨迹", group=recipe];
  flatfits [label="planetes_flat.fits", shape=folder, group=product];
  rawwave [label="波长灯 cube\n独立 wave dark\n静态谱线 FITS", group=raw];
  wave [label="planetes_wave\n谱线识别、波长解", group=recipe];
  wavefits [label="planetes_wave.fits", shape=folder, group=product];
  rawp2vm [label="六条基线 cube\n四个望远镜 flat\n可选相位参考及 dark", group=raw];
  p2vm [label="planetes_p2vm\n提取、重采样、矩阵标定", group=recipe];
  p2vmfits [label="planetes_p2vm.fits", shape=folder, group=product];
  rawsci [label="science cube\n可选 science dark", group=raw];
  reduce [label="planetes_reduce\n应用标定、提取可见度", group=recipe];
  sciencefits [label="planetes_reduced.fits\n仪器可见度、差分相位\n相干通量、GD、标志", shape=folder, group=product];
  {rank=same; rawflat; flat; flatfits;}
  {rank=same; rawwave; wave; wavefits;}
  {rank=same; rawp2vm; p2vm; p2vmfits;}
  {rank=same; rawsci; reduce; sciencefits;}
  rawflat -> flat -> flatfits;
  rawwave -> wave -> wavefits;
  rawp2vm -> p2vm -> p2vmfits;
  rawsci -> reduce -> sciencefits;
  flatfits -> wave;
  flatfits -> p2vm;
  wavefits -> p2vm;
  flatfits -> reduce;
  wavefits -> reduce;
  p2vmfits -> reduce;
  rawflat -> rawwave -> rawp2vm -> rawsci [style=invis];
  flat -> wave -> p2vm -> reduce [style=invis];
  note [label="所有原始输入只读\n每一步通过 .sof 指定文件角色\n结果含来源、参数、QC、校验和", shape=note];
  sciencefits -> note [style=invis];
}
