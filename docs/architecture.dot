digraph Architecture {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.4, ranksep=0.55, fontname="PingFang SC", fontsize=20, label="PLANETES 0.16.0 — 每个产品一个模块", labelloc=t];
  node [shape=box, style="rounded", fontname="PingFang SC", fontsize=14, color="#64748b", margin="0.16,0.12"];
  edge [fontname="PingFang SC", fontsize=11, color="#64748b", arrowsize=0.7];
  python [label="Python 脚本 / examples\n<step>.run(文件…, output_dir=…)"];
  recipes [label="eso/recipes.py（PyEsoRex）\n读 SOF / CPL 参数 → 调用同一个 run()\n签名 DATAMD5 · 登记 PRODUCT\n唯一 import CPL 的文件"];
  steps [label="dark.py · flat.py · wave.py · p2vm/ · reduce.py\n\n每个模块从上到下：\n数据类 → 算法 → qc() → read_/write_ → run()\n波长 / OPD / GD 使用 m；计算 float64", style="rounded,filled", fillcolor="#eff6ff"];
  shared [label="extraction.py · kernels.py\n共用提取 / group delay · 全部 numba kernel"];
  files [label="files.py\nraw：memmap 读取，不加载整个 cube\n产品：checksum · 不覆盖\nQC 卡片 · PRO 溯源 header"];
  base [label="instrument.py · keywords.py\n通道顺序 · DetectorSetup · Raw\n全部 keyword / tag / QC / recipe 参数"];
  {rank=same; python; recipes;}
  python -> steps;
  recipes -> steps [label="同一个 run()"];
  steps -> shared;
  steps -> files [label="读 raw / 读写产品"];
  files -> base;
  steps -> base;
}
