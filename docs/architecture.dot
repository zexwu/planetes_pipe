digraph Architecture {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.4, ranksep=0.5, fontname="PingFang SC", fontsize=20, label="PLANETES 0.4 — 科学计算与执行入口", labelloc=t];
  node [shape=box, style="rounded", fontname="PingFang SC", fontsize=14, color="#64748b", margin="0.16,0.12"];
  edge [fontname="PingFang SC", fontsize=11, color="#64748b", arrowsize=0.7];
  python [label="Python / 研究脚本\n显式文件、参数和保存"];
  eso [label="PyEsoRex → eso/ (PyCPL)\nSOF 类别 · 参数 · DFS 签名"];
  gui [label="Qt6 GUI\n原始未 bin 帧 + 明确 dark"];
  tasks [label="五个独立科学任务\ndark · flat · wavelength · p2vm · reduction\n文件入口调用数组计算", style="rounded,filled", fillcolor="#eff6ff"];
  live [label="FrameReducer\n标定快照准备一次"];
  kernels [label="共用科学计算\n扣暗 · 稀疏提取 · 重采样\n物理响应 · 可见度 · flags", style="rounded,filled", fillcolor="#eff6ff"];
  models [label="models.py + instrument.py\n具名科学对象 · 单位 · 数组轴\nDARK/BAD/FLAT/WAVE 父关系与物理配置"];
  fits [label="fits.py + keywords.py + qc.py\n原始元数据 · FITS 单位/坐标边界\n有源码依据的命名/QC · 校验与不覆盖发布"];
  acquisition [label="自动 take_p2vm / GUI capture\n读回或明确命令/人工配置"];
  raw [label="format-3 raw\n原像素/dtype · 命名图像扩展\n物理快门 · DIT/ROI · 来源", shape=folder];
  disk [label="format-3 科学产品\n独立 DARK + BAD · 标定表 · 仪器级结果\n必要 PLANETES 扩展保留", shape=folder];
  {rank=same; python; eso; gui;}
  python -> tasks; eso -> tasks; gui -> live;
  tasks -> kernels; live -> kernels;
  kernels -> models;
  models -> fits [label="显式编解码"];
  fits -> disk;
  acquisition -> fits [label="同一 raw writer"];
  fits -> raw [label="写出新文件"];
  raw -> tasks [label="共同 reader"];
}
