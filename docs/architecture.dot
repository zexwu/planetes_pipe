digraph Architecture {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.5, fontname="PingFang SC", fontsize=20, label="PLANETES 0.3 — 一套科学实现，三个入口", labelloc=t];
  node [shape=box, style="rounded", fontname="PingFang SC", fontsize=14, color="#64748b", margin="0.16,0.12"];
  edge [fontname="PingFang SC", fontsize=11, color="#64748b", arrowsize=0.7];
  python [label="Python / 研究脚本\n显式文件和参数"];
  eso [label="PyEsoRex → eso/\nSOF 角色 · 参数 · DFS 登记"];
  gui [label="Qt6 台架 GUI\n原始未 bin 帧 + 明确 dark"];
  tasks [label="按科学任务组织\ndark.py · flat.py · wavelength.py\np2vm.py · reduction.py\n文件任务 + 数组计算", style="rounded,filled", fillcolor="#eff6ff"];
  live [label="reduction.FrameReducer\n载入时准备标定快照"];
  kernels [label="extraction.py + reduction.py\n共用扣暗、提取、重采样\n通量、可见度归一化与 flags", style="rounded,filled", fillcolor="#eff6ff"];
  models [label="models.py + instrument.py\n科学对象 · 单位 · 轴 · 仪器约定\n父标定指纹检查"];
  fits [label="fits.py\n原始数据读取\n共用 FITS 编解码与安全发布"];
  memory [label="内存科学对象\nPython 显式保存；GUI 直接显示", shape=folder];
  disk [label="schema-2 FITS\n单位、映射、参数、来源、校验和\n原始文件只读；目标不覆盖", shape=folder];
  {rank=same; python; eso; gui;}
  python -> tasks;
  eso -> tasks;
  gui -> live;
  tasks -> kernels;
  live -> kernels;
  tasks -> fits [label="读取 / ESO 写出"];
  kernels -> models;
  models -> memory [label="返回"];
  memory -> fits [label="显式保存"];
  fits -> disk;
}
