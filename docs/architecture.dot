digraph Architecture {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.5, fontname="PingFang SC", fontsize=18, label="PLANETES 0.2 模块职责", labelloc=t];
  node [shape=box, style="rounded", fontname="PingFang SC", fontsize=14, color="#64748b", margin="0.16,0.12"];
  edge [fontname="PingFang SC", fontsize=12, color="#64748b", arrowsize=0.7];
  sof [label="输入文件清单 .sof\nrecipe 参数 / .rc"];
  runner [label="PyEsoRex\n加载并执行 recipe"];
  recipes [label="planetes/eso\nflat · wave · p2vm · reduce\n验证标签、管理参数、登记产品"];
  processing [label="processing.py\n完整读取 cube、组织提取\n保留 16 帧分块"];
  algorithms [label="algorithms\n只接收科学对象和显式参数\n返回计算结果、标志及诊断量"];
  models [label="product.py\n数组、单位与轴的共同契约\n无全局配置和文件读写"];
  io [label="io/products.py\nFITS 编解码与完整性检查\n复数和布尔标志无损往返"];
  dfs [label="CPL DFS utilities\n输入来源、recipe、参数\n产品签名和校验和"];
  files [label="校准 / 仪器科学 FITS\n独立输出目录；已有文件不覆盖", shape=folder];
  sof -> runner -> recipes;
  recipes -> processing -> algorithms;
  recipes -> io;
  recipes -> dfs;
  algorithms -> models [label="返回对象"];
  io -> models [dir=both, label="编解码"];
  io -> files;
  dfs -> files;
  {rank=same; processing; io; dfs;}
  {rank=same; algorithms; models;}
}
