digraph Architecture {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.4, ranksep=0.5, fontname="PingFang SC", fontsize=20, label="PLANETES 0.4.1 — 入口、科学计算与文件边界", labelloc=t];
  node [shape=box, style="rounded", fontname="PingFang SC", fontsize=14, color="#64748b", margin="0.16,0.12"];
  edge [fontname="PingFang SC", fontsize=11, color="#64748b", arrowsize=0.7];
  python [label="Python / 研究脚本"];
  recipes [label="PyEsoRex → recipes/planetes_*.py\nparameters.py · dfs.py\n全部 CPL 操作限定在这里"];
  gui [label="Qt6 GUI / 自动采集"];
  tasks [label="tasks.py\n读取、配置关联、调用计算\n返回具名科学产品", style="rounded,filled", fillcolor="#eff6ff"];
  science [label="数组科学计算\ncalibration/ · extraction.py · reduction.py\n不读取文件，不导入 Astropy/CPL", style="rounded,filled", fillcolor="#eff6ff"];
  live [label="FrameReducer\n原始未 bin 帧 + 明确 dark"];
  io [label="io/raw.py · io/fits.py\n原始元数据 / 产品编解码\npublication.py：校验、不覆盖发布"];
  qc [label="qc.py：质量统计\n物理量名称、数值和缺失原因"];
  keywords [label="io/keywords.py\nFITS 类别、扩展名\n物理 QC 名称 → ESO keyword"];
  products [label="products.py · instrument.py · identity.py\n科学对象、单位、轴、物理配置与内容身份"];
  {rank=same; python; recipes; gui;}
  python -> tasks; recipes -> tasks;
  gui -> tasks [label="载入标定 / dark"];
  gui -> live [label="逐帧"];
  tasks -> science;
  tasks -> io [label="显式 I/O"];
  recipes -> io [label="共用产品编码"];
  gui -> io [label="统一 raw writer"];
  live -> science;
  io -> keywords;
  io -> qc [label="写出时测量"];
  science -> products;
  qc -> products;
}
