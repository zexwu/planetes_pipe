digraph Dataflow {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.5, splines=polyline, fontname="PingFang SC", fontsize=20, label="PLANETES 0.3 — 标定与科学数据流程", labelloc=t];
  node [shape=box, style="rounded", fontname="PingFang SC", fontsize=14, color="#64748b", margin="0.15,0.12"];
  edge [fontname="PingFang SC", fontsize=11, color="#64748b", arrowsize=0.7];
  rawdark [label="多帧原始 dark\n按 main / lamp / science 分别选择"];
  dark [label="dark 任务\n均值 · temporal RMS · 坏像素", style="rounded,filled", fillcolor="#eff6ff"];
  darkfits [label="DarkCalibration\nplanetes_dark.fits", shape=folder];
  rawflat [label="四个望远镜 flat cube"];
  flat [label="flat 任务\n响应 · trace · 稀疏提取几何", style="rounded,filled", fillcolor="#eff6ff"];
  flatfits [label="FlatCalibration\nplanetes_flat.fits", shape=folder];
  rawwave [label="波长灯 cube + 静态谱线"];
  wave [label="wave 任务\n谱线匹配 · 波长解", style="rounded,filled", fillcolor="#eff6ff"];
  wavefits [label="WavelengthCalibration\nplanetes_wave.fits", shape=folder];
  rawp2vm [label="4 个 telescope + 6 个 baseline cube\n可选 phase reference / 独立 dark"];
  p2vm [label="p2vm 任务\n提取 · 物理响应 · 求逆", style="rounded,filled", fillcolor="#eff6ff"];
  p2vmfits [label="P2VMCalibration\nplanetes_p2vm.fits\n保存目标波长网格", shape=folder];
  rawscience [label="science cube / 单帧 raw\n明确选择 science dark"];
  science [label="reduce_file / FrameReducer\n共用提取、归一化、flags", style="rounded,filled", fillcolor="#eff6ff"];
  results [label="离线：完整仪器结果 → 显式 FITS\n实时：内存可见度 + flags → GUI\nGD / 差分相位可选计算", shape=folder];
  {rank=same; rawdark; dark; darkfits;}
  {rank=same; rawflat; flat; flatfits;}
  {rank=same; rawwave; wave; wavefits;}
  {rank=same; rawp2vm; p2vm; p2vmfits;}
  {rank=same; rawscience; science; results;}
  rawdark -> dark -> darkfits;
  rawflat -> flat -> flatfits;
  rawwave -> wave -> wavefits;
  rawp2vm -> p2vm -> p2vmfits;
  rawscience -> science -> results;
  darkfits -> flat;
  darkfits -> wave;
  darkfits -> p2vm;
  darkfits -> science;
  flatfits -> wave;
  flatfits -> p2vm;
  flatfits -> science;
  wavefits -> p2vm;
  wavefits -> science;
  p2vmfits -> science [label="采用保存的网格"];
  rawdark -> rawflat -> rawwave -> rawp2vm -> rawscience [style=invis];
  dark -> flat -> wave -> p2vm -> science [style=invis];
}
